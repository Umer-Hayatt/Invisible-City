# Copy to .env.local and fill in. Never commit real values.
# Where to get each one: docs/SETUP.md

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated Gmail addresses that sign in as Super Admin
SUPER_ADMIN_EMAILS=
# true on the public site: shows the Demo banner and the role switcher
DEMO_MODE=true

# --- Supabase (Postgres + Google sign-in) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Transaction pooler string (port 6543), used by the app on Vercel
DATABASE_URL=
# Direct / session-mode string, used only by migration and seed scripts
DIRECT_DATABASE_URL=

# --- Cloudinary (photos) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Gmail (outgoing email via app password) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- AI ---
GEMINI_API_KEY=
# Optional fallback; the offline keyword guess is used if both are missing
GROQ_API_KEY=
# GROQ_MODEL=

# --- Current app only (removed in PLAN steps 2-4) ---
# ADMIN_PASSCODE=
# SEED_DEMO_DATA=true
